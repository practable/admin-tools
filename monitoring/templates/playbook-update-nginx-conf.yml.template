---
- name: reload nginx config
  hosts: ${ANSIBLE_GROUP}
  become: yes
    
  tasks:

   - name: copy nginx conf file
     copy: src=../autogenerated/nginx.conf dest=/etc/nginx/nginx.conf
     notify: reload nginx

   - name: copy htpasswd
     copy: src=../autogenerated/htpasswd dest=/etc/nginx/htpasswd
     notify: reload nginx

   - name: Ensure nginx maps .wasm files to the application/wasm MIME type
     ansible.builtin.lineinfile:
       path: /etc/nginx/mime.types
       regexp: '^\s*application/wasm\s+wasm;\s*$'
       line: '    application/wasm                                 wasm;'
       insertbefore: '^}\s*$'
       state: present
       backup: yes
     notify: reload nginx

   - name: Verify Nginx config
     become: yes
     command: nginx -t
     changed_when: false
  
  handlers:
        
    - name: reload nginx
      ansible.builtin.service:
        name: nginx
        state: reloaded



